# Default packet filtering policies
config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

# LAN firewall zone configuration (isolated downstream VLAN)
config zone 'zone_lan'
	option name 'lan'
	list network 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'

# WAN firewall zone configuration with NAT masquerading enabled
config zone 'zone_wan'
	option name 'wan'
	list network 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'

# Rule 1: Drop all traffic from LAN targeting upstream private subnets (RFC 1918)
config rule 'block_upstream_private'
	option name 'Block-Upstream-Private-Subnets'
	option src 'lan'
	option dest 'wan'
	list dest_ip '10.0.0.0/8'
	list dest_ip '172.16.0.0/12'
	list dest_ip '192.168.0.0/16'
	option target 'DROP'

# Rule 2: Forward transit traffic from LAN to WAN for standard internet browsing
config forwarding 'fwd_lan_wan'
	option src 'lan'
	option dest 'wan'