# Global default packet filtering policies
config defaults
	# Protect the router from SYN flood attacks
	option syn_flood '1'
	# Reject packets attempting to enter router processes unless allowed
	option input 'REJECT'
	# Allow outbound traffic generated by router processes
	option output 'ACCEPT'
	# Reject transit traffic passing between zones by default
	option forward 'REJECT'

# Downstream client LAN zone configuration
config zone 'zone_lan'
	option name 'lan'
	list network 'lan'
	# Accept local management traffic (DNS, DHCP, SSH) from clients to the router
	option input 'ACCEPT'
	# Allow router replies to reach the LAN clients
	option output 'ACCEPT'
	# Allow intra-zone forwarding among clients on the LAN bridge
	option forward 'ACCEPT'

# Upstream WAN zone configuration
config zone 'zone_wan'
	option name 'wan'
	list network 'wan'
	# Reject incoming connection attempts from the parent network
	option input 'REJECT'
	# Allow the router to send traffic out to the upstream network and internet
	option output 'ACCEPT'
	# Reject routed transit attempts coming into the WAN
	option forward 'REJECT'
	# Enable source NAT masquerading for outbound internet packets
	option masq '1'
	# Adjust TCP MSS automatically to prevent fragmentation issues
	option mtu_fix '1'

# Inter-zone transit rule: allow LAN to WAN forwarding for the public internet
# The negated destination address '!192.168.40.0/24' guarantees that any traffic
# targeting the upstream router or parent subnet hits the global forward REJECT policy.
config forwarding 'fwd_lan_wan'
	option src 'lan'
	option dest 'wan'
	option dest_ip '!192.168.40.0/24'