# Global default packet filtering policies
config defaults
	# Protect router from SYN flood attacks
	option syn_flood '1'
	# Reject packets entering router processes unless allowed
	option input 'REJECT'
	# Allow outbound packets originating from the router itself
	option output 'ACCEPT'
	# Reject inter-zone forward transit by default
	option forward 'REJECT'

# Downstream client LAN zone configuration
config zone 'zone_lan'
	option name 'lan'
	list network 'lan'
	# Allow management traffic from LAN clients (DNS, DHCP, SSH)
	option input 'ACCEPT'
	# Allow router replies back to LAN clients
	option output 'ACCEPT'
	# Allow intra-zone communication among clients on LAN
	option forward 'ACCEPT'

# Upstream WAN zone configuration
config zone 'zone_wan'
	option name 'wan'
	list network 'wan'
	# Reject incoming connection attempts from upstream
	option input 'REJECT'
	# Allow router outbound traffic to upstream network
	option output 'ACCEPT'
	# Reject routed transit entering WAN
	option forward 'REJECT'
	# Enable source NAT masquerading for internet access
	option masq '1'
	# Adjust TCP MSS automatically
	option mtu_fix '1'

# Rule 1: Allow internet forwarding ONLY for traffic NOT targeting the parent network
# Replaces config forwarding to prevent unconditional transit leaks
config rule 'forward_internet_only'
	option name 'Allow-LAN-to-Internet-Except-Upstream'
	option src 'lan'
	option dest 'wan'
	option dest_ip '!192.168.40.0/24'
	option target 'ACCEPT'