# Default packet filtering policies
config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

# LAN firewall zone - downstream VLAN clients on eth1 (restricted router input)
config zone 'zone_lan'
	option name 'lan'
	list network 'lan'
	option input 'REJECT' # add a rule to allow router input
	option output 'ACCEPT'
	option forward 'ACCEPT'

# WAN firewall zone - upstream via eth0, NAT masquerade enabled
config zone 'zone_wan'
	option name 'wan'
	list network 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'

# Allow DNS requests from server to OpenWrt router
config rule 'allow_lan_dns'
	option name 'Allow-LAN-DNS'
	option src 'lan'
	option proto 'tcpudp'
	option dest_port '53'
	option target 'ACCEPT'

# Allow DHCP requests from server to OpenWrt router
config rule 'allow_lan_dhcp'
	option name 'Allow-LAN-DHCP'
	option src 'lan'
	option proto 'udp'
	option dest_port '67-68'
	option target 'ACCEPT'

# Rule 1a: Block all protocols (incl. ICMP/ping) from LAN to 10.0.0.0/8 upstream
# Must appear BEFORE the forwarding rule to take priority
config rule 'block_upstream_10'
	option name 'Block-Upstream-10.0.0.0/8'
	option src 'lan'
	option dest 'wan'
	option dest_ip '10.0.0.0/8'
	option proto 'all'
	option target 'DROP'

# Rule 1b: Block all protocols (incl. ICMP/ping) from LAN to 172.16.0.0/12 upstream
config rule 'block_upstream_172'
	option name 'Block-Upstream-172.16.0.0/12'
	option src 'lan'
	option dest 'wan'
	option dest_ip '172.16.0.0/12'
	option proto 'all'
	option target 'DROP'

# Rule 1c: Block all protocols (incl. ICMP/ping) from LAN to 192.168.0.0/16 upstream
config rule 'block_upstream_192'
	option name 'Block-Upstream-192.168.0.0/16'
	option src 'lan'
	option dest 'wan'
	option dest_ip '192.168.0.0/16'
	option proto 'all'
	option target 'DROP'

# Rule 2: Allow LAN clients to reach the internet (public IPs only reach here)
config forwarding 'fwd_lan_wan'
	option src 'lan'
	option dest 'wan'